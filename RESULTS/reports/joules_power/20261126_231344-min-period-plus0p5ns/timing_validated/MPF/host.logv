[11/26 23:17:50     14s] #@ Begin verbose source (pre): source /home/weber/PESSOAL/intra-smooth-filter-VVC/backend/syn/work/check_scaled_timing.tcl
[11/26 23:17:50     14s] @file 1: # Read-only analysis of a finished routed checkpoint at the requested clock.
[11/26 23:17:50     14s] @file 2: source [file join [file dirname [info script]] scaled_clock_constraints.tcl]
[11/26 23:17:50     14s] #@ Begin verbose source /home/weber/PESSOAL/intra-smooth-filter-VVC/backend/syn/work/scaled_clock_constraints.tcl (pre)
[11/26 23:17:50     14s] @file 1: # Re-evaluate SI timing while solving for a zero-slack period. No DB is written.
[11/26 23:17:50     14s] @file 2: proc setup_at_period {period prefix} {
[11/26 23:17:50     14s]   # Update the mode SDC in place and retain each view's CTS source latencies.
[11/26 23:17:50     14s]   set modes [glob -directory [file join $::env(SCALED_TIMING_DB) mmmc modes] *]
[11/26 23:17:50     14s]   if {[llength $modes] != 1} {error "Expected one functional constraint mode"}
[11/26 23:17:50     14s]   set mode [file tail [lindex $modes 0]]
[11/26 23:17:50     14s]   set original [file join [lindex $modes 0] ${mode}.sdc]
[11/26 23:17:50     14s]   set f [open $original r]; set constraints [read $f]; close $f
[11/26 23:17:50     14s]   set replacement [format {create_clock -name clk -period %.12g [get_ports {clk}]} $period]
[11/26 23:17:50     14s]   if {[regsub -line {^create_clock[^\n]*$} $constraints $replacement constraints] != 1} {
[11/26 23:17:50     14s]     error "Expected exactly one source clock"
[11/26 23:17:50     14s]   }
[11/26 23:17:50     14s]   set path [file join $::env(SCALED_TIMING_OUTPUT) ${prefix}.sdc]
[11/26 23:17:50     14s]   set f [open $path w]; puts $f $constraints; close $f
[11/26 23:17:50     14s]   update_constraint_mode -name $mode -sdc_files [list $path]
[11/26 23:17:50     14s]   foreach latency [glob -directory [file join $::env(SCALED_TIMING_DB) mmmc views] */latency.sdc] {
[11/26 23:17:50     14s]     update_analysis_view -name [file tail [file dirname $latency]] -latency_file $latency
[11/26 23:17:50     14s]   }
[11/26 23:17:50     14s]   extract_rc
[11/26 23:17:50     14s]   time_design -post_route -report_dir $::env(SCALED_TIMING_OUTPUT) -report_prefix $prefix
[11/26 23:17:50     14s]   set report [file join $::env(SCALED_TIMING_OUTPUT) ${prefix}.summary.gz]
[11/26 23:17:50     14s]   set text [exec gzip -dc $report]
[11/26 23:17:50     14s]   if {![regexp {WNS \(ns\):\|\s*([-0-9.]+)} $text -> slack]} {error "Missing setup slack in $report"}
[11/26 23:17:50     14s]   return $slack
[11/26 23:17:50     14s] }
[11/26 23:17:50     14s] #@ End verbose source /home/weber/PESSOAL/intra-smooth-filter-VVC/backend/syn/work/scaled_clock_constraints.tcl
